# ---- Ollama (local) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_QUERY_MODEL=qwen2.5:3.5b   # model dùng cho Giai đoạn 1 - Query Analyzer
OLLAMA_GEN_MODEL=qwen3:8b          # model dùng cho Giai đoạn 5 - sinh câu trả lời

# ---- Qdrant (Dense retrieval) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hspl_child_chunks

# ---- Embedding & Reranker ----
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_TOKENS=1024

# ---- Retrieval tuning ----
TOP_K_DENSE=50
TOP_K_SPARSE=50
INTERSECTION_MIN=15
FALLBACK_TOP_N=5
RERANK_TOP_N=5

# ---- Nguồn dữ liệu Parent (MongoDB hoặc file) ----
PARENT_STORE_URI=mongodb://localhost:27017
PARENT_STORE_DB=hspl
PARENT_STORE_COLLECTION=parent_articles
